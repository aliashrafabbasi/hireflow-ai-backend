APP_NAME=HireFlow AI Backend
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

GROQ_API_KEY=gsk_your_actual_groq_api_key_here


DEBUG=True

# The only database setting. Use your local PostgreSQL URL while developing;
# replace it with the Neon connection URL in the deployment environment.
DATABASE_URL=postgresql://hireflow_user:hireflow_password@localhost:5432/hireflow_db

SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Visible RPA (email → browser opens while backend runs — no separate RPA server)
# Docker runs browser automation headlessly. Set false when RPA is not required.
RPA_ENABLED=false
HF_EMAIL=your_hireflow_login@example.com
HF_PASSWORD=your_hireflow_password
HF_BASE_URL=http://localhost:3000
# optional Slack tab at end:
# SLACK_CHANNEL_URL=https://app.slack.com/client/...
RPA_SLOW_MO_MS=500
RPA_HEADLESS=true
