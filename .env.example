APP_NAME=HireFlow AI Backend
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

GROQ_API_KEY=gsk_your_actual_groq_api_key_here
# Groq model (llama-3.3-70b-versatile was retired 2026-08-16)
GROQ_MODEL=openai/gpt-oss-120b

DEBUG=true

# Use 127.0.0.1 — local PostgreSQL (pgAdmin on port 5432).
DATABASE_URL=postgresql://hireflow_user:your_password@127.0.0.1:5432/hireflow_db

SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Visible RPA (email → browser opens while backend runs)
RPA_ENABLED=false
HF_EMAIL=your_hireflow_login@example.com
HF_PASSWORD=your_hireflow_password
HF_BASE_URL=http://localhost:3000
# SLACK_CHANNEL_URL=https://app.slack.com/client/...
RPA_SLOW_MO_MS=500
RPA_HEADLESS=false
