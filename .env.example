# HireFlow AI - Backend Environment Configuration

APP_NAME="HireFlow AI Backend"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=true

# Database (For Docker Compose, use container host 'db')
DATABASE_URL=postgresql://hireflow_user:admin123@db:5432/hireflow_db
# If running locally outside Docker, use:
# DATABASE_URL=postgresql://hireflow_user:admin123@127.0.0.1:5432/hireflow_db

POSTGRES_DB=hireflow_db
POSTGRES_USER=hireflow_user
POSTGRES_PASSWORD=admin123
POSTGRES_PORT=5432

# Security & JWT
SECRET_KEY=hireflow_ai_super_secret_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# RPA / Playwright Settings (Optional)
RPA_ENABLED=false
RPA_HEADLESS=true
HF_EMAIL=admin@hireflow.ai
HF_PASSWORD=adminpassword
HF_BASE_URL=http://localhost:3000
