APP_NAME=HireFlow AI Backend
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

GROQ_API_KEY=gsk_your_actual_groq_api_key_here


DEBUG=True

DATABASE_URL=postgresql://username:password@localhost:5432/database_name

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Visible RPA (email → browser opens while backend runs — no separate RPA server)
RPA_ENABLED=true
HF_EMAIL=your_hireflow_login@example.com
HF_PASSWORD=your_hireflow_password
HF_BASE_URL=http://localhost:3000
# optional Slack tab at end:
# SLACK_CHANNEL_URL=https://app.slack.com/client/...
RPA_SLOW_MO_MS=500
RPA_HEADLESS=false
